# Демонстрационная конфигурация Docker Compose: cp .env.example .env
# Пароли ниже — демо-значения, замените их перед запуском.
#
# Пароль подставляется в DATABASE_URL без экранирования, поэтому используйте
# только латиницу, цифры, «-» и «_» (символы @ : / # ? % ломают адрес подключения).
#
# PostgreSQL и Grafana применяют пароли только при первой инициализации томов.
# Чтобы сменить их позже, пересоздайте тома: docker compose down -v (удалит данные).

POSTGRES_DB=afisha
POSTGRES_USER=afisha
POSTGRES_PASSWORD=afisha_demo_password

GRAFANA_USER=admin
GRAFANA_PASSWORD=afisha_grafana_demo

# Опубликованные порты (Prometheus и Grafana слушают только 127.0.0.1)
FRONTEND_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Источники, которым backend разрешает CORS (через Nginx frontend ходит с того же origin)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
